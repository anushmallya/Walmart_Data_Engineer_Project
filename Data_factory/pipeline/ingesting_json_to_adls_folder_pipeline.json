{
	"name": "ingesting_json_to_adls_folder_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Get_Metadata_monitor_source",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "metadata_monitor_file",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "ForEach_monitor_source",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_Metadata_monitor_source",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Metadata_monitor_source').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy_monitor_source_to_folder",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "monitor_source_json_source",
									"type": "DatasetReference",
									"parameters": {
										"p_file": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "monitor_source_json_sink",
									"type": "DatasetReference",
									"parameters": {
										"p_folder_1": {
											"value": "@pipeline().parameters.p_name",
											"type": "Expression"
										},
										"p_folder_2": {
											"value": "@{pipeline().parameters.p_name}_monitor",
											"type": "Expression"
										},
										"p_files": {
											"value": "@{pipeline().parameters.p_name}_@{item().name}",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"p_name": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-28T09:42:18Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}