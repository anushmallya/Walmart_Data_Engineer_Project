{
	"name": "SQL_Database_to_adls_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Monitor_database_lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT TABLE_SCHEMA, TABLE_NAME\nFROM INFORMATION_SCHEMA.TABLES\nWHERE TABLE_TYPE = 'BASE TABLE';",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQL_Database_lookup",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_loop",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Monitor_database_lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Metadata_of_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Monitor_database_lookup').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "If_bornze_not_contain_item",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@not(contains(string(activity('Metadata_of_bronze').output.childItems),item().TABLE_NAME))",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Execute Pipeline2",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "ingesting_sql_database_to_adls_parquet",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"p_table": {
													"value": "@item().TABLE_NAME",
													"type": "Expression"
												},
												"p_schema": {
													"value": "@item().TABLE_SCHEMA",
													"type": "Expression"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Execute Pipeline1",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "ingesting_json_to_adls_folder_pipeline",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"p_name": {
													"value": "@item().TABLE_NAME",
													"type": "Expression"
												}
											}
										}
									},
									{
										"name": "Execute Pipeline2_copy1",
										"type": "ExecutePipeline",
										"dependsOn": [
											{
												"activity": "Execute Pipeline1",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "ingesting_sql_database_to_adls_parquet",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"p_table": {
													"value": "@item().TABLE_NAME",
													"type": "Expression"
												},
												"p_schema": {
													"value": "@item().TABLE_SCHEMA",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Metadata_of_bronze",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "getting_meta_data_bronze",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "ParquetReadSettings"
					}
				}
			}
		],
		"variables": {
			"v_date": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-29T06:15:52Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}