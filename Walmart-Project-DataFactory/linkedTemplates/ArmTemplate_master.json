{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Walmart-Project-DataFactory"
		},
		"AzureDatabricks_link_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricks_link'"
		},
		"AzureSqlDatabase_Link_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase_Link'"
		},
		"FileServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileServer1'"
		},
		"walmartpstorageaccount_link_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'walmartpstorageaccount_link'"
		},
		"AzureDatabricks_link_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1003-103711-3139ih7f"
		},
		"AzureSqlDatabase_Link_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "walmart-project-server.database.windows.net"
		},
		"AzureSqlDatabase_Link_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "walmart_db"
		},
		"AzureSqlDatabase_Link_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "wpadmin"
		},
		"FileServer1_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "D:\\Projects\\Walmart_Project\\dataset"
		},
		"FileServer1_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "anushmallya@gmail.com"
		},
		"walmartpstorageaccount_link_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://walmartpstorageaccount.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "Walmart-Project-DataFactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDatabricks_link_accessToken": {
						"value": "[parameters('AzureDatabricks_link_accessToken')]"
					},
					"AzureSqlDatabase_Link_password": {
						"value": "[parameters('AzureSqlDatabase_Link_password')]"
					},
					"walmartpstorageaccount_link_accountKey": {
						"value": "[parameters('walmartpstorageaccount_link_accountKey')]"
					},
					"FileServer1_password": {
						"value": "[parameters('FileServer1_password')]"
					},
					"AzureDatabricks_link_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks_link_properties_typeProperties_existingClusterId')]"
					},
					"AzureSqlDatabase_Link_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_Link_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_Link_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_Link_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_Link_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_Link_properties_typeProperties_userName')]"
					},
					"walmartpstorageaccount_link_properties_typeProperties_url": {
						"value": "[parameters('walmartpstorageaccount_link_properties_typeProperties_url')]"
					},
					"FileServer1_properties_typeProperties_host": {
						"value": "[parameters('FileServer1_properties_typeProperties_host')]"
					},
					"FileServer1_properties_typeProperties_userId": {
						"value": "[parameters('FileServer1_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "Walmart-Project-DataFactory_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'Walmart-Project-DataFactory_ArmTemplate_0')]"
			]
		}
	]
}