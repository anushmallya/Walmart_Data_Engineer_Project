													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "monitor_source_json_sink",
											"type": "DatasetReference",
											"parameters": {
												"p_folder_1": {
													"value": "@pipeline().parameters.p_name",
													"type": "Expression"
												},
												"p_folder_2": {
													"value": "@{pipeline().parameters.p_name}_monitor",
													"type": "Expression"
												},
												"p_files": {
													"value": "@{pipeline().parameters.p_name}_@{item().name}",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
